# Токен бота від @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Ключ Gemini API: https://aistudio.google.com → Get API key (безкоштовний ліміт)
GEMINI_API_KEY=your-gemini-key

# ID групи менеджерів (група з увімкненими темами, бот — адмін з правом керувати темами).
# Дізнатися ID: додайте бота в групу і напишіть там /id
MANAGER_CHAT_ID=-1001234567890

# Telegram ID адміністраторів через кому (/stats, оновлення бази знань). Свій ID: напишіть боту /id
ADMIN_IDS=123456789

# Назва магазину в привітанні та промпті
SHOP_NAME=VoltShop

# Моделі Gemini (якщо модель застаріла — візьміть актуальну назву в Google AI Studio)
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Запасні моделі через кому — якщо основна перевантажена (503) або вичерпано ліміт (429)
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite

# Скільки останніх повідомлень пам'ятати і скільки фрагментів бази знань брати
HISTORY_LIMIT=5
TOP_K=4
